model WebhookDelivery {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  subscriptionId String   @db.Uuid
  event          String
  payload        Json
  attemptNumber  Int      @default(1)
  maxRetries     Int      @default(3)
  status         String   @default("PENDING")
