generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  CUSTOMER
  AUDITOR
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RecordVisibility {
  INTERNAL
  CUSTOMER_SHARED
}

enum LeadStatus {
  NEW
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

enum TicketStatus {
  NEW
  OPEN
  PENDING_CUSTOMER
  PENDING_INTERNAL
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)
  memberships Membership[]
  teams       Team[]
  projects    Project[]
  milestones  Milestone[]
  workLogs    WorkLog[]
  tasks       Task[]
  accounts    Account[]
  contacts    Contact[]
  leads       Lead[]
  deals       Deal[]
  tickets     Ticket[]
  activities  Activity[]
  auditEvents AuditEvent[]
  notifications Notification[]
  scheduledActivities ScheduledActivity[]
  mentions Mention[]
  apiKeys ApiKey[]
  integrationProviders IntegrationProvider[]
  backupRecords BackupRecord[]
  deadLetters NotificationDeadLetter[]
  jobs Job[]
  customFields CustomField[]
  automationRules AutomationRule[]
  automationRuns AutomationRun[]
  documentSpaces DocumentSpace[]
  documents Document[]
  webhookSubscriptions WebhookSubscription[]
  webhookDeliveries WebhookDelivery[]
  productCatalogItems ProductCatalogItem[]
  proformaInvoices ProformaInvoice[]
  supportMacros SupportMacro[]
  supportSequences SupportSequence[]
}

model User {
  id                String        @id @default(uuid()) @db.Uuid
  email             String        @unique
  displayName       String
  passwordHash      String?
  status            String        @default("ACTIVE")
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)
  memberships       Membership[]
  teamMemberships   TeamMember[]
  createdTasks      Task[]        @relation("TaskCreator")
  assignedTasks     Task[]        @relation("TaskAssignee")
  taskComments      TaskComment[]
  ownedAccounts     Account[]     @relation("AccountOwner")
  ownedContacts     Contact[]     @relation("ContactOwner")
  ownedLeads        Lead[]        @relation("LeadOwner")
  ownedDeals        Deal[]        @relation("DealOwner")
  assignedTickets   Ticket[]      @relation("TicketAssignee")
  ticketMessages    TicketMessage[]
  ownedProjects     Project[]      @relation("ProjectOwner")
  workLogs          WorkLog[]
  activities        Activity[]    @relation("ActivityActor")
  auditEvents       AuditEvent[]  @relation("AuditActor")
  notifications     Notification[]
  ownedScheduledActivities ScheduledActivity[] @relation("ScheduledActivityOwner")
  notificationPreference   NotificationPreference?
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  userId         String         @db.Uuid
  role           MembershipRole @default(MEMBER)
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([organizationId, userId])
  @@index([userId, active])
  @@index([organizationId, role, active])
}

model Team {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        TeamMember[]
  projects       Project[]
  @@unique([organizationId, name])
  @@index([organizationId])
}

model TeamMember {
  teamId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([teamId, userId])
  @@index([userId])
}

model Project {
  id                    String       @id @default(uuid()) @db.Uuid
  organizationId        String       @db.Uuid
  teamId                String?      @db.Uuid
  key                   String
  name                  String
  description           String?
  status                String       @default("ACTIVE")
  health                String       @default("ON_TRACK")
  ownerId               String?      @db.Uuid
  ownerName             String?
  startDate             DateTime?    @db.Timestamptz(6)
  targetDate            DateTime?    @db.Timestamptz(6)
  associatedAccountId   String?      @db.Uuid
  associatedAccountName String?
  createdAt             DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  owner          User?        @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks          Task[]
  milestones     Milestone[]
  @@unique([organizationId, key])
  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@index([organizationId, targetDate])
}

model Milestone {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  projectId      String       @db.Uuid
  title          String
  dueDate        DateTime     @db.Timestamptz(6)
  isCompleted    Boolean      @default(false)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([organizationId, projectId, dueDate])
  @@index([projectId])
}

model WorkLog {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  userId          String       @db.Uuid
  userName        String
  entityType      String
  entityId        String
  entityTitle     String
  durationMinutes Int
  description     String
  isBillable      Boolean      @default(true)
  loggedDate      DateTime     @db.Date
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([organizationId, loggedDate])
  @@index([organizationId, userId, loggedDate])
  @@index([organizationId, entityType, entityId])
}

model Task {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  projectId      String?         @db.Uuid
  creatorId      String          @db.Uuid
  assigneeId     String?         @db.Uuid
  parentId       String?         @db.Uuid
  title          String
  description    String?
  status         TaskStatus      @default(TODO)
  priority       TaskPriority    @default(MEDIUM)
  visibility     RecordVisibility @default(INTERNAL)
  dueAt          DateTime?       @db.Timestamptz(6)
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator        User            @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee       User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parent         Task?           @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Task[]          @relation("TaskHierarchy")
  comments       TaskComment[]
  dependencies   TaskDependency[] @relation("DependentTask")
  dependents     TaskDependency[] @relation("DependencyTarget")
  @@index([organizationId, status, priority])
  @@index([organizationId, assigneeId, status])
  @@index([organizationId, dueAt])
  @@index([projectId, status])
}

model TaskDependency {
  taskId        String   @db.Uuid
  dependsOnId   String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  task          Task     @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn     Task     @relation("DependencyTarget", fields: [dependsOnId], references: [id], onDelete: Cascade)
  @@id([taskId, dependsOnId])
  @@index([dependsOnId])
}

model TaskComment {
  id         String           @id @default(uuid()) @db.Uuid
  taskId     String           @db.Uuid
  authorId   String           @db.Uuid
  body       String
  visibility RecordVisibility @default(INTERNAL)
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)
  task       Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author     User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([taskId, createdAt])
}

model Account {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  ownerId        String?      @db.Uuid
  name           String
  type           String       @default("COMPANY")
  status         String       @default("ACTIVE")
  website        String?
  phone          String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?        @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts       Contact[]
  leads          Lead[]
  deals          Deal[]
  tickets        Ticket[]
  @@index([organizationId, name])
  @@index([organizationId, ownerId])
}

model Contact {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  accountId      String?      @db.Uuid
  ownerId        String?      @db.Uuid
  firstName      String
  lastName       String
  email          String?
  phone          String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  owner          User?        @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, email])
}

model Lead {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  accountId      String?      @db.Uuid
  ownerId        String?      @db.Uuid
  displayName    String
  email          String?
  phone          String?
  source         String?
  status         LeadStatus   @default(NEW)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  owner          User?        @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  @@index([organizationId, status, createdAt])
  @@index([organizationId, email])
}

model Deal {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  accountId      String?      @db.Uuid
  ownerId        String?      @db.Uuid
  name           String
  stage          String       @default("QUALIFICATION")
  amountMinor    BigInt?
  currency       String?
  probability    Int?
  targetCloseAt  DateTime?    @db.Timestamptz(6)
  lossReason     String?
  lossDescription String?
  lostAt         DateTime?    @db.Timestamptz(6)
  nextActionTitle String?
  nextActionDueAt DateTime?   @db.Timestamptz(6)
  stageUpdatedAt DateTime?    @db.Timestamptz(6)
  products       Json?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  owner          User?        @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  @@index([organizationId, stage, targetCloseAt])
  @@index([organizationId, ownerId])
}

model Ticket {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  accountId      String?        @db.Uuid
  assigneeId     String?        @db.Uuid
  reference      String
  title          String
  status         TicketStatus   @default(NEW)
  priority       TicketPriority @default(NORMAL)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  assignee       User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages       TicketMessage[]
  @@unique([organizationId, reference])
  @@index([organizationId, status, priority, createdAt])
  @@index([organizationId, assigneeId, status])
}

model TicketMessage {
  id         String           @id @default(uuid()) @db.Uuid
  ticketId   String           @db.Uuid
  authorId   String?          @db.Uuid
  body       String
  visibility RecordVisibility @default(CUSTOMER_SHARED)
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)
  ticket     Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  @@index([ticketId, createdAt])
}

model Activity {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorId        String?      @db.Uuid
  entityType     String
  entityId       String       @db.Uuid
  kind           String
  summary        String
  visibility     String       @default("INTERNAL")
  occurredAt     DateTime     @default(now()) @db.Timestamptz(6)
  metadata       Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([organizationId, entityType, entityId, occurredAt])
  @@index([organizationId, actorId, occurredAt])
}

model ScheduledActivity {
  id                    String   @id @default(uuid()) @db.Uuid
  organizationId        String   @db.Uuid
  type                  String
  title                 String
  description           String?
  startsAt              DateTime @db.Timestamptz(6)
  endsAt                DateTime @db.Timestamptz(6)
  isAllDay              Boolean  @default(false)
  status                String   @default("SCHEDULED")
  ownerId               String   @db.Uuid
  ownerName             String?
  participantIds        String[]
  associatedEntityType  String?
  associatedEntityId    String?
  associatedEntityTitle String?
  visibility            String   @default("INTERNAL")
  reminderMinutesBefore Int?
  isPinned              Boolean  @default(false)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User         @relation("ScheduledActivityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  @@index([organizationId, startsAt, endsAt])
  @@index([organizationId, ownerId, startsAt])
  @@index([organizationId, status])
}

model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorId        String?      @db.Uuid
  action         String
  entityType     String
  entityId       String
  requestId      String?
  ipAddress      String?
  metadata       Json?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model Notification {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  type           String
  title          String       @default("")
  message        String       @default("")
  payload        Json
  dedupeKey      String?
  readAt         DateTime?    @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
  @@index([organizationId, createdAt])
  @@unique([organizationId, userId, dedupeKey])
}

model NotificationPreference {
  userId    String   @id @db.Uuid
  inApp     Boolean  @default(true)
  email     Boolean  @default(true)
  push      Boolean  @default(false)
  digest    Boolean  @default(true)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Mention {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  sourceEntityType String
  sourceEntityId  String
  sourceTitle     String
  authorId        String   @db.Uuid
  authorName      String
  recipientId     String   @db.Uuid
  recipientName   String
  contextSnippet  String
  readAt          DateTime? @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, recipientId, readAt])
  @@index([organizationId, sourceEntityType, sourceEntityId])
}

model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  keyPrefix      String
  hashedKey      String
  scopes         String[]
  lastUsedAt     DateTime? @db.Timestamptz(6)
  expiresAt      DateTime? @db.Timestamptz(6)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, active])
}

model IntegrationProvider {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  providerKey    String
  name           String
  description    String
  icon           String
  status         String    @default("DISCONNECTED")
  configSummary  Json?
  lastSyncedAt   DateTime? @db.Timestamptz(6)
  errorMessage   String?
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, providerKey])
  @@index([organizationId, status])
}

model BackupRecord {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String?  @db.Uuid
  scope             String
  status            String
  description       String?
  version           String
  algorithm         String
  iv                String
  authTag           String
  checksumSha256    String
  encryptedData     String   @db.Text
  sizeBytes         BigInt
  recordCounts      Json
  rpoTargetMinutes  Int
  rtoEstimatedSeconds Int
  retentionDays     Int
  expiresAt         DateTime @db.Timestamptz(6)
  createdBy         String   @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  completedAt       DateTime? @db.Timestamptz(6)
  metadata          Json?
  organization Organization? @relation(fields: [organizationId], references: [id])
  drills RestoreDrill[]
  @@index([organizationId, status])
  @@index([expiresAt])
}

model RestoreDrill {
  id                      String   @id @default(uuid()) @db.Uuid
  backupId                String   @db.Uuid
  organizationId          String?  @db.Uuid
  executedBy              String   @db.Uuid
  success                 Boolean
  integrityVerified       Boolean
  checksumMatched         Boolean
  decryptionSuccessful    Boolean
  versionCompatible       Boolean
  schemaCompatible        Boolean
  simulatedRecordsRestored Int
  rtoActualMs             Int
  rpoActualMinutes        Int
  rpoTargetMinutes        Int
  rtoEstimatedSeconds     Int
  meetsRpoTarget          Boolean
  meetsRtoTarget          Boolean
  executedAt              DateTime @default(now()) @db.Timestamptz(6)
  details                 String   @db.Text
  validationErrors        String[]
  backup BackupRecord @relation(fields: [backupId], references: [id], onDelete: Cascade)
  @@index([backupId])
}

model NotificationDeadLetter {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  channel        String
  recipient      String
  title          String
  message        String
  payload        Json?
  dedupeKey      String?
  retryCount     Int      @default(0)
  maxRetries     Int      @default(3)
  lastError      String
  status         String   @default("PENDING")
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  failedAt       DateTime @default(now()) @db.Timestamptz(6)
  resolvedAt     DateTime? @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, status, failedAt])
}

model Job {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  type           String
  priority       String   @default("NORMAL")
  payload        Json
  result         Json?
  error          String?
  status         String   @default("QUEUED")
  maxAttempts    Int      @default(3)
  attempts       Int      @default(0)
  runAt          DateTime @default(now()) @db.Timestamptz(6)
  startedAt      DateTime? @db.Timestamptz(6)
  completedAt    DateTime? @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([status, runAt, priority])
  @@index([organizationId, status])
  @@index([type])
}

model CustomField {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  entityType     String
  key            String
  label          String
  type           String
  options        String[]
  isRequired     Boolean  @default(false)
  defaultValue   Json?
  order          Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, entityType, key])
  @@index([organizationId, entityType, active])
}

model AutomationRule {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  trigger        String
  conditionField String?
  conditionValue String?
  actionType     String
  actionPayload  Json
  enabled        Boolean  @default(true)
  executionCount Int      @default(0)
  lastExecutedAt DateTime? @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, trigger, enabled])
}

model AutomationRun {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  ruleId         String   @db.Uuid
  ruleName       String
  trigger        String
  status         String
  executedAction String
  actionDetails  String
  payloadSummary String
  executedAt     DateTime @default(now()) @db.Timestamptz(6)
  durationMs     Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, executedAt])
  @@index([ruleId])
}

model DocumentSpace {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  slug           String
  description    String?
  icon           String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents Document[]
  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Document {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @db.Uuid
  spaceId             String   @db.Uuid
  title               String
  slug                String
  content             String   @db.Text
  visibility          String   @default("WORKSPACE")
  isPublished         Boolean  @default(false)
  authorId            String   @db.Uuid
  authorName          String
  version             Int      @default(1)
  tags                String[]
  associatedEntityType String?
  associatedEntityId  String?
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  space        DocumentSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  revisions    DocumentRevision[]
  @@index([organizationId, spaceId, isPublished])
  @@index([organizationId, visibility])
}

model DocumentRevision {
