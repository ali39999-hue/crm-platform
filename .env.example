# Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit .env.
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# Local-only credentials from compose.yaml; change before sharing this environment.
POSTGRES_DB=crm_dev
POSTGRES_USER=crm_dev
POSTGRES_PASSWORD=local_dev_only_change_me
DATABASE_URL=postgresql://crm_dev:local_dev_only_change_me@localhost:5432/crm_dev?schema=public
DIRECT_URL=postgresql://crm_dev:local_dev_only_change_me@localhost:5432/crm_dev?schema=public
REDIS_URL=redis://localhost:6379

# Local MinIO. These values are for developer machines only.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=crm-local
S3_ACCESS_KEY_ID=crm-local-access
S3_SECRET_ACCESS_KEY=local-minio-secret-key-change-me-123456
S3_FORCE_PATH_STYLE=true

# Browser/client endpoints. Never expose server-side secrets with NEXT_PUBLIC_/EXPO_PUBLIC_.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OIDC integration is not implemented in the starter. Fill only after selecting a provider.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4000/api/v1/auth/callback

# Optional observability integrations; keep empty in local development unless configured.
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
